#!/bin/sh
# Strip trailing whitespace from staged added/modified text files.
# Worktrees share this hooks directory (core.hooksPath), so every worker commit
# satisfies the `git diff --check refs/heads/main..HEAD` completion contract.
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0
printf '%s\n' "$files" | while IFS= read -r f; do
    [ -f "$f" ] || continue
    # skip binary files
    LC_ALL=C grep -Iq . "$f" 2>/dev/null || continue
    before=$(md5sum "$f" | cut -d' ' -f1)
    perl -i -pe 's/[ \t]+$//' "$f"
    after=$(md5sum "$f" | cut -d' ' -f1)
    if [ "$before" != "$after" ]; then
        git add "$f"
    fi
done
exit 0
